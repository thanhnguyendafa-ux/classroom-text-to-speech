rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPlaylist(data) {
      return data.keys().hasAll(['title', 'rawText', 'speechList', 'settings', 'createdAt', 'updatedAt', 'schemaVersion'])
          && data.title is string && data.title.size() <= 200
          && data.rawText is string && data.rawText.size() <= 100000
          && data.speechList is list
          && data.settings is map
          && data.createdAt is number
          && data.updatedAt is number
          && data.schemaVersion is number;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'])
          && data.keys().size() == 5
          && data.displayName is string && data.displayName.size() <= 120
          && data.email is string && data.email.size() <= 120
          && (data.photoURL is string || data.photoURL == null)
          && data.createdAt is number
          && data.lastLoginAt is number;
    }

    function isValidFolder(data) {
      return data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
          && data.keys().size() == 3
          && data.name is string && data.name.size() <= 120
          && data.createdAt is number
          && data.updatedAt is number;
    }

    function isValidLesson(data) {
      return data.title is string && data.title.size() <= 200
          && data.rawText is string && data.rawText.size() <= 100000
          && data.createdAt is number
          && data.updatedAt is number
          && (!data.keys().hasAny(['folderId']) || (data.folderId is string || data.folderId == null))
          && (!data.keys().hasAny(['speechList']) || data.speechList is list)
          && (!data.keys().hasAny(['settings']) || data.settings is map);
    }

    function isValidPremiumAudioAsset(data) {
      return data.keys().hasAll(['assetId', 'cacheKey', 'textHash', 'textPreview', 'lang', 'voice', 'status', 'sourceVersion', 'createdAt', 'updatedAt'])
          && data.keys().size() >= 10
          && data.assetId is string && data.assetId.size() <= 128
          && data.cacheKey is string && data.cacheKey.size() <= 1000
          && data.textHash is string && data.textHash.size() <= 64
          && data.textPreview is string && data.textPreview.size() <= 500
          && data.lang is string && data.lang.size() <= 16
          && data.voice is string && data.voice.size() <= 64
          && data.status is string && (data.status == 'ready' || data.status == 'pending' || data.status == 'failed')
          && data.sourceVersion is string && data.sourceVersion == 'premium-tts-v1'
          && data.createdAt is number
          && data.updatedAt is number
          && (!data.keys().hasAny(['storagePath']) || (data.storagePath is string || data.storagePath == null))
          && (!data.keys().hasAny(['errorCode']) || (data.errorCode is string || data.errorCode == null))
          && (!data.keys().hasAny(['errorMessage']) || (data.errorMessage is string || data.errorMessage == null));
    }

    // Public Playlist creation and reading (now requires auth to maintain private domain)
    match /playlists/{playlistId} {
      allow get: if request.auth != null && isValidId(playlistId);
      allow create: if request.auth != null && isValidId(playlistId) && isValidPlaylist(incoming());
      allow update, delete: if false;
    }

    // Secure User, Folder, and Lesson isolated domains
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId && isValidId(userId);
      allow create, update: if request.auth != null && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow delete: if false;

      // User's own Folders
      match /folders/{folderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && isValidId(folderId) && isValidFolder(incoming());
        allow update: if request.auth != null && request.auth.uid == userId && isValidId(folderId) && isValidFolder(incoming());
        allow delete: if request.auth != null && request.auth.uid == userId && isValidId(folderId);
      }

      // User's own Lessons
      match /lessons/{lessonId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && isValidId(lessonId) && isValidLesson(incoming());
        allow update: if request.auth != null && request.auth.uid == userId && isValidId(lessonId) && isValidLesson(incoming());
        allow delete: if request.auth != null && request.auth.uid == userId && isValidId(lessonId);

        // Nested Audio Assets Manifests
        match /audioAssets/{assetId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId && isValidId(assetId) && isValidPremiumAudioAsset(incoming());
          allow update: if request.auth != null && request.auth.uid == userId && isValidId(assetId) && isValidPremiumAudioAsset(incoming());
          allow delete: if request.auth != null && request.auth.uid == userId && isValidId(assetId);
        }
      }
    }
  }
}
