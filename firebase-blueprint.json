{
  "entities": {
    "SpeechItem": {
      "title": "SpeechItem",
      "description": "A single spoken line within a pronunciation practice playlist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "detectedLang": { "type": "string" },
        "selectedLang": { "type": "string" },
        "resolvedLang": { "type": "string" },
        "repeats": { "type": "number" },
        "delaySec": { "type": "number" },
        "speed": { "type": "number" },
        "setId": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "text", "detectedLang", "selectedLang", "resolvedLang", "repeats"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "A structured practice playlist with audio speech options",
      "type": "object",
      "properties": {
        "speechList": {
          "type": "array",
          "description": "List of pronunciation and speech elements"
        },
        "speed": { "type": "number" },
        "volume": { "type": "number" },
        "autoAdvance": { "type": "boolean" },
        "timeBetweenLines": { "type": "number" },
        "playlistLoopMode": { "type": "string", "enum": ["once", "infinite"] },
        "engineMode": { "type": "string", "enum": ["browser", "premium"] },
        "createdAt": { "type": "string" }
      },
      "required": ["speechList", "speed", "volume", "autoAdvance", "timeBetweenLines", "playlistLoopMode", "engineMode", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile document containing metadata",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["displayName", "email", "createdAt", "lastLoginAt"]
    },
    "Folder": {
      "title": "Folder",
      "description": "Folders created by users to group lessons",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "createdAt", "updatedAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Personal lessons saved on cloud",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "folderId": { "type": "string" },
        "rawText": { "type": "string" },
        "speechList": { "type": "array" },
        "settings": { "type": "object" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "rawText", "createdAt", "updatedAt"]
    },
    "PremiumAudioAsset": {
      "title": "PremiumAudioAsset",
      "description": "Metadata manifest for persistent premium audio assets",
      "type": "object",
      "properties": {
        "assetId": { "type": "string" },
        "cacheKey": { "type": "string" },
        "textHash": { "type": "string" },
        "textPreview": { "type": "string" },
        "lang": { "type": "string" },
        "voice": { "type": "string" },
        "status": { "type": "string", "enum": ["ready", "pending", "failed"] },
        "storagePath": { "type": "string" },
        "errorCode": { "type": "string" },
        "errorMessage": { "type": "string" },
        "sourceVersion": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["assetId", "cacheKey", "textHash", "textPreview", "lang", "voice", "status", "sourceVersion", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "Collection of shared pronunciation practice playlists"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profile metadata"
    },
    "users/{userId}/folders/{folderId}": {
      "schema": "Folder",
      "description": "Folders owned by the user"
    },
    "users/{userId}/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Cloud lessons owned by the user"
    },
    "users/{userId}/lessons/{lessonId}/audioAssets/{assetId}": {
      "schema": "PremiumAudioAsset",
      "description": "Metadata manifests of cached premium audio pieces"
    }
  }
}
